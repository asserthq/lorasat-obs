{
	"nodes":[
		{"id":"79a4e07ea2ededb1","type":"text","text":"**обзор недельной работы**","x":-125,"y":-30,"width":250,"height":60},
		{"id":"e6e7717fb87876b9","type":"text","text":"**незавершенные действия**","x":220,"y":-30,"width":260,"height":60},
		{"id":"35d1a2f37fcbaf7b","type":"text","text":"сколько не выполнено и почему ?","x":-125,"y":280,"width":250,"height":60},
		{"id":"db0024ea953b5311","type":"text","text":"сколько задач выполнено ?","x":-125,"y":180,"width":250,"height":60},
		{"id":"6ebd374273856f4c","type":"text","text":"цель спринта достигнута ?","x":-125,"y":80,"width":250,"height":60},
		{"id":"c18d08f65cba45a5","type":"text","text":"какие задачи не завершены или ожидаются ?","x":220,"y":80,"width":260,"height":60},
		{"id":"2a5fc3ca737ae5b9","type":"text","text":"**обработка входящих**","x":580,"y":-30,"width":220,"height":60},
		{"id":"b19817adecce926b","type":"text","text":"прогоняем входящие по схеме","x":580,"y":80,"width":220,"height":60},
		{"id":"19387c7c594c0719","type":"text","text":"удалить ненужное, организовать нужное","x":580,"y":174,"width":220,"height":73},
		{"id":"e613478a49fccb9e","type":"text","text":"смотрим на ближайшую контрольную точку","x":900,"y":80,"width":240,"height":60},
		{"id":"07c64ff6f0ccb3b4","type":"text","text":"выбираем из бэклога задачи на спринт","x":1220,"y":80,"width":220,"height":60},
		{"id":"c92acf2748c43ee4","type":"text","text":"**проверка загрузки**","x":1580,"y":-30,"width":200,"height":60},
		{"id":"f093e15cca6b32dc","type":"text","text":"**ПИВО**\nпрограммирование\nинтеллектуалы\nV значит вендетта\nорбитальные","x":1960,"y":-30,"width":220,"height":170},
		{"id":"f6a9bb04026113dc","type":"text","text":"что нужно перенести / удалить / напомнить ?","x":240,"y":187,"width":220,"height":60},
		{"id":"c6a66ef77efa204f","type":"text","text":"**выбор цели**","x":950,"y":-30,"width":140,"height":60},
		{"id":"a4c6e9e3d384f88c","type":"text","text":"формулируем проверяемый результат недели","x":890,"y":187,"width":260,"height":60},
		{"id":"a861dda68db0bb6f","type":"text","text":"**отбор задач**","x":1260,"y":-30,"width":140,"height":60},
		{"id":"4016a0e587bc7d11","type":"text","text":"делегируем если можем","x":1210,"y":187,"width":240,"height":60},
		{"id":"b7eef54edd814037","type":"text","text":"выбираем предварительно приоритет и исполнителя","x":1200,"y":300,"width":260,"height":60},
		{"id":"c5591ab4bcf40956","type":"text","text":"примерно прикидываем сколько часов на все задачи","x":1550,"y":80,"width":260,"height":60},
		{"id":"8237d1adc19c8577","type":"text","text":"решаем блокировки (зависимость от других участников и задач), порядок выполнения","x":1168,"y":420,"width":325,"height":100},
		{"id":"845ea2d0b4e4309f","type":"text","text":"по каждому: время на задачи делить на фулл рабочее время недели (с учетом пар и тд)","x":1553,"y":187,"width":255,"height":120},
		{"id":"8f30f5aed799e5ed","type":"text","text":"должен быть запас процентов 30","x":1571,"y":360,"width":220,"height":60}
	],
